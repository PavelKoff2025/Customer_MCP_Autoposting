# === Telegram Bot API ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Прокси для доступа к Telegram без системного VPN (socks5://[user:pass@]host:port
# или http(s)://[user:pass@]host:port). Пусто — запросы идут напрямую.
TELEGRAM_PROXY_URL=

# === VK API ===
# Две независимые цели: группа + личная страница. Достаточно одной пары.
# Группа (сообщество/паблик): токен сообщества с правами wall, photos.
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Личная страница: пользовательский токен (OAuth, права wall, photos, offline).
VK_USER_TOKEN=
VK_USER_ID=
VK_API_VERSION=5.199

# === TenChat (Playwright) ===
TENCHAT_HEADLESS=true
TENCHAT_SESSION_PATH=./storage/sessions/tenchat.json
# Время жизни меты сессии (часы). Пока мета свежее — validateCredentials
# не запускает Playwright, а опирается на keep-alive по cron (launchd).
# Если мета устарела — фоллбэк на реальную headless-проверку.
TENCHAT_SESSION_TTL_HOURS=10

# === Генерация изображений ===
IMAGE_API_URL=
IMAGE_API_KEY=

# === Общие ===
CONTENT_DIR=./content
LOG_LEVEL=info
STORAGE_DIR=./storage
